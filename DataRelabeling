print(train_test_split["test"].features["label"].names) 

# %%
# resize images for training 
from PIL import Image

IMG_SIZE = (128, 128)   

def preprocess(batch):
    batch["image"] = [img.convert("RGB").resize(IMG_SIZE) for img in batch["image"]]
    return batch

train_test_split = train_test_split.map(preprocess, batched=True)

# %%
# convert train and test to arrays 
def to_numpy(split):
    n = len(split)
    X = np.empty((n, 128, 128, 3), dtype=np.uint8)   
    for i, img in enumerate(split["image"]):
        X[i] = np.array(img)
    y = np.array(split["label"])
    return X, y


X_train, y_train = to_numpy(train_test_split["train"])
X_test, y_test = to_numpy(train_test_split["test"])

print(X_train.shape)  
print(y_train.shape)  

# %%
# try a simple CNN to ensure that the reshaping made it so the images 
# can be passed through the network
from tensorflow import keras
from tensorflow.keras import layers, models

model = models.Sequential([
    layers.Input(shape=(128, 128, 3)),
    layers.Rescaling(1./255),                  
    layers.Conv2D(32, 3, activation="relu"),
    layers.MaxPooling2D(),
    layers.Flatten(),
    layers.Dense(32, activation="relu"),
    layers.Dropout(0.5),                      
    layers.Dense(8, activation="softmax"),
])

model.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",    
    metrics=["accuracy"],
)

model.summary()
# %%
history = model.fit(
    X_train, y_train,
    validation_data=(X_test, y_test),
    epochs=5,
    batch_size=32,
)

# %% 
test_loss, test_accuracy = model.evaluate(X_test, y_test)
print(f'Test accuracy: {test_accuracy:.4f}')
